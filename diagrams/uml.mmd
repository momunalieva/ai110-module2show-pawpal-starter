classDiagram
    class Owner {
        +name: string
        +preferences: string
        +addPet(pet)
        +addTask(task)
    }

    class Pet {
        +name: string
        +species: string
        +careNotes: string
        +addTask(task)
    }

    class Task {
        +title: string
        +durationMinutes: int
        +priority: string
        +scheduledStart: datetime
        +scheduledEnd: datetime
        +overlaps(otherTask)
    }

    class Scheduler {
        +scheduleTasks(tasks)
        +sortByPriority(tasks)
        +detectConflicts(tasks)
    }

    Owner "1" --> "0..*" Pet : owns
    Owner "1" --> "0..*" Task : plans
    Pet "1" --> "0..*" Task : needs care
    Scheduler ..> Task : orders and schedules
